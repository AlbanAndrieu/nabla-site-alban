{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "next:dev",
      "detail": "Next.js dev server on port 3000 (same as Playwright baseURL; open this URL in the browser for chrome-devtools-mcp).",
      "type": "shell",
      "command": "npm run dev -- -p 3000",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "3000"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "next:dev (background)",
      "detail": "Same as next:dev but marked background for compounds or preLaunchTask (waits until Local: line appears).",
      "type": "shell",
      "command": "npm run dev -- -p 3000",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "3000"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "source": "next dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Next\\.js.*",
          "endsPattern": ".*Local:.*http://localhost:3000.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
