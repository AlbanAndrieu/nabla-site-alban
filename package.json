{
	"name": "nabla-site-alban",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"description": "Bilingual Next.js portfolio for Alban Andrieu, cybersecurity and DevSecOps engineer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlbanAndrieu/nabla-site-alban.git"
	},
	"author": "Alban Andrieu (aandrieu)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/AlbanAndrieu/nabla-site-alban/issues"
	},
	"homepage": "https://github.com/AlbanAndrieu/nabla-site-alban#readme",
	"engines": {
		"node": ">=24.11.0 <25",
		"npm": ">=11.17.0 <12"
	},
	"scripts": {
		"lint": "eslint --format gitlab .",
		"lint:css": "stylelint public/*.css",
		"typecheck": "tsc --noEmit",
		"quality:fix": "biome check --write .",
		"quality:gate": "bash scripts/quality-gate.sh",
		"check": "npm run lint && npm run lint:css && npm run typecheck && npm run test:unit && npm run build",
		"audit": "npm audit --audit-level=moderate",
		"dev": "next dev",
		"dev:test": "next dev --hostname 127.0.0.1",
		"build": "next build",
		"start": "next start",
		"start:test": "next start --hostname 127.0.0.1",
		"start:python": "npx http-server public -p 8001",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:report": "playwright show-report",
		"test:unit": "node --import tsx --test \"unit-tests/**/*.test.ts\"",
		"i18n:libretranslate": "node scripts/translate-with-libretranslate.mjs"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.220.0",
		"@opentelemetry/instrumentation": "^0.220.0",
		"@opentelemetry/sdk-logs": "^0.220.0",
		"@stripe/react-stripe-js": "^6.1.0",
		"@stripe/stripe-js": "^9.1.0",
		"@vercel/otel": "^2.1.3",
		"@xyflow/react": "12.11.3",
		"next": "16.3.1",
		"next-intl": "^4.9.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"stripe": "^20.4.1"
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^20.3.1",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.58.0",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/node": "^20.11.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.8.0",
		"eslint-config-next": "^0.2.4",
		"eslint-formatter-gitlab": "^7.2.0",
		"lodash-es": "^4.18.1",
		"playwright": "^1.58.0",
		"postcss-selector-parser": "^7.1.4",
		"stylelint": "^17.14.1",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0"
	},
	"allowScripts": {
		"@parcel/watcher": false,
		"@swc/core": false,
		"esbuild": false,
		"fsevents": false
	}
}
