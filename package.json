{
	"name": "nabla-site-alban",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"description": "Bilingual Next.js portfolio for Alban Andrieu, cybersecurity and DevSecOps engineer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlbanAndrieu/nabla-site-alban.git"
	},
	"author": "Alban Andrieu (aandrieu)",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/AlbanAndrieu/nabla-site-alban/issues"
	},
	"homepage": "https://github.com/AlbanAndrieu/nabla-site-alban#readme",
	"engines": {
		"node": ">=24.22.1 <25",
		"npm": ">=12.2.0 <13"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.1",
			"onFail": "warn"
		}
	},
	"scripts": {
		"lint": "eslint --format ./scripts/eslint-github-formatter.mjs .",
		"lint:fix": "eslint --fix --format ./scripts/eslint-github-formatter.mjs .",
		"lint:css": "stylelint \"app/**/*.css\" \"components/**/*.css\" \"public/*.css\"",
		"lint:css:fix": "stylelint --fix \"app/**/*.css\" \"components/**/*.css\" \"public/*.css\"",
		"typecheck": "bash scripts/run-next-clean.sh typegen && tsc --noEmit",
		"quality:fix": "bash scripts/agent-quality-gate.sh --fix",
		"quality:gate": "bash scripts/quality-gate.sh",
		"check": "npm run rss:check && npm run lint && npm run lint:css && npm run typecheck && npm run test:unit && npm run build",
		"audit": "npm audit --audit-level=moderate",
		"audit:dead-code": "npx --yes --ignore-scripts knip@6.35.0 --config knip.jsonc --reporter compact --no-progress",
		"dev": "bash scripts/run-next-clean.sh dev",
		"dev:test": "bash scripts/run-next-clean.sh dev --hostname 127.0.0.1",
		"build": "bash scripts/run-next-clean.sh build",
		"start": "next start",
		"start:test": "next start --hostname 127.0.0.1",
		"start:python": "npx http-server public -p 8001",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:report": "playwright show-report",
		"test:baselines": "playwright test tests/integration-baseline.spec.ts tests/security-baseline.spec.ts tests/performance-baseline.spec.ts --project=chromium",
		"test:integration": "playwright test tests/integration-baseline.spec.ts --project=chromium",
		"test:security": "playwright test tests/security-baseline.spec.ts --project=chromium",
		"test:performance": "playwright test tests/performance-baseline.spec.ts --project=chromium",
		"test:fast:local": "node scripts/agent-node22-fast.mjs",
		"test:fast:node22": "node scripts/agent-node22-fast.mjs",
		"test:unit": "node --import tsx --test --test-reporter=dot \"unit-tests/**/*.test.ts\" && node --test --test-reporter=dot unit-tests/*.test.mjs",
		"test:unit:verbose": "node --import tsx --test \"unit-tests/**/*.test.ts\" && node --test unit-tests/*.test.mjs",
		"i18n:libretranslate": "node scripts/translate-with-libretranslate.mjs",
		"oco": "node scripts/run-opencommit.mjs",
		"opencommit": "node scripts/run-opencommit.mjs",
		"quality:agent": "bash scripts/agent-quality-gate.sh",
		"quality:agent:fix": "bash scripts/agent-quality-gate.sh --fix",
		"quality:agent:publish": "bash scripts/agent-publish.sh",
		"test:a11y": "bash scripts/run-a11y-local.sh",
		"rss:check": "node scripts/generate-security-rss.mjs --check",
		"diagnose:homelab-429": "node scripts/diagnose-homelab-429.mjs",
		"audit:homelab": "node scripts/audit-homelab-access.mjs"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.223.0",
		"@opentelemetry/instrumentation": "^0.223.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@vercel/otel": "^2.1.3",
		"@xyflow/react": "12.12.0",
		"next": "16.4.2",
		"next-intl": "^4.14.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"stripe": "^20.4.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@commitlint/config-conventional": "^20.3.1",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "9.39.5",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.2",
		"eslint-formatter-gitlab": "^7.2.0",
		"lodash-es": "^4.18.1",
		"opencommit": "^3.3.11",
		"playwright": "^1.64.0",
		"stylelint": "^17.14.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"@parcel/watcher": false,
		"@swc/core": false,
		"esbuild": false,
		"fsevents": false,
		"unrs-resolver": false
	}
}
