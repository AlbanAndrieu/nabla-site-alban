{
	"name": "nabla-site-alban",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Simple HTML project for Nabla company promoting Alban Andrieu as an experienced DevSecOps",
	"main": "index.html",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlbanAndrieu/nabla-site-alban.git"
	},
	"author": "Alban Andrieu (aandrieu)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/AlbanAndrieu/nabla-site-alban/issues"
	},
	"homepage": "https://github.com/AlbanAndrieu/nabla-site-alban#readme",
	"engines": {
		"node": "24.x",
		"npm": ">=11.6.2"
	},
	"scripts": {
		"postinstall": "copyfiles -f ./node_modules/d3/d3.min.js ./index/dist/scripts/d3 && copyfiles -f ./app/scripts/arf.js ./dist/scripts/ && copyfiles -f ./app/resources/*.json ./dist/resources && copyfiles -f ./index.html ./dist/ && copyfiles -f ./wireframe.css ./dist/",
		"lint": "eslint --format gitlab .",
		"audit": "npm audit --audit-level=moderate",
		"dev": "next dev",
		"dev:cf": "wrangler dev",
		"dev:v": "vercel",
		"build": "next build",
		"start": "next start",
		"deploy": "wrangler deploy",
		"start:wrangler": "wrangler dev",
		"start:python": "npx http-server public -p 8001",
		"start:stripe": "node server.cjs",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:report": "playwright show-report",
		"test:unit": "node --import tsx --test \"unit-tests/**/*.test.ts\"",
		"build:includes": "node scripts/build-html-includes.js",
		"i18n:libretranslate": "node scripts/translate-with-libretranslate.mjs",
		"oco": "node scripts/run-opencommit.mjs",
		"opencommit": "node scripts/run-opencommit.mjs"
	},
	"dependencies": {
		"@astrojs/vercel": "^10.0.2",
		"@datadog/browser-rum": "^6.24.1",
		"@stripe/react-stripe-js": "^6.1.0",
		"@stripe/stripe-js": "^9.1.0",
		"@vercel/analytics": "^1.5.0",
		"@vercel/speed-insights": "^1.2.0",
		"@vercel/toolbar": "^0.2.2",
		"crypto": "^1.0.1",
		"express": "^4.21.0",
		"lodash-es": "^4.18.1",
		"next": "^16.2.3",
		"next-intl": "^4.9.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"stripe": "^20.4.1",
		"vercel": "^51.8.0",
		"webdriver-manager": "^12.1.9"
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^20.3.1",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.58.0",
		"@types/express": "5.0.0",
		"@types/node": "20.11.17",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"copyfiles": "2.4.1",
		"d3": "7.9.0",
		"eslint": "^9.39.1",
		"eslint-config-next": "^16.2.2",
		"eslint-formatter-gitlab": "^6.0.1",
		"opencommit": "^3.2.19",
		"playwright": "^1.58.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"wrangler": "^4.59.1"
	}
}
