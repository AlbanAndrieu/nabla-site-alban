# Public Ahrefs analytics identifier rendered into the page by app/layout.tsx.
AHREFS_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_MODE=vercel

# Server-only owner homelab IP allowlist on Vercel (not NEXT_PUBLIC_*).
# Deploy in Vercel Project Settings > Environment Variables for Preview/Production.
# Restricts raw OWNER surfaces; temporary public v2 projections are separately gated.
HOMELAB_TRUSTED_CIDRS=82.66.4.247/32
# Temporary external display of sanitized read-only Backstage v2 projections.
# Public disclosure even when the visitor is not at home. Turn off for OWNER-only mode.
HOMELAB_PUBLIC_READONLY_ENABLED=true
# Signed Cloudflare Access JWT (if configured) may authorize a remote owner
# outside the home CIDR. Disable alongside PUBLIC_READONLY at secure cutover.
HOMELAB_OWNER_REMOTE_ACCESS_ENABLED=true
# Optional additional owner authentication, still enforced on raw OWNER surfaces.
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Server-only SERVICE authentication for the canonical Backstage v2 reader.
# FastAPI GET /api/site/catalog/v2 accepts X-Diagnostics-Key.
# The Preview value is intentionally invalid for a negative-auth test.
# Set a valid key later as a sensitive Vercel env var, never NEXT_PUBLIC_*.
# DIAGNOSTICS_ACCESS_KEY=

# OWNER diagnostics still require the verified browser home-CIDR/Access gate.
# When a server-only DIAGNOSTICS_ACCESS_KEY is configured, the owner-gated
# Next.js routes can fetch FastAPI's temporarily remote-enabled OWNER endpoints.
# Set to false to disable outbound OWNER diagnostics. Never set NEXT_PUBLIC_*.
# HOMELAB_OWNER_RAW_UPSTREAM_ENABLED=false
